<!DOCTYPE html>
<html>
  <head>
    <title>PingMe Chat</title>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="http://netdna.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="vendor/bootstrap_5.3.8/css/bootstrap.min.css">
    <script src="/socket.io/socket.io.js"></script>
    <script src="vendor/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="vendor/bootstrap_5.3.8/js/bootstrap.min.js"></script>
    <script src="js/plugins.js"></script>
    <script src="vendor/gun/gun.js"></script>
    <script src="vendor/gun/sea.js"></script>
    <script>window.gunPort = <%= gunPort %>; // GUN relay port, passed in by index.js</script>
    <script src="js/authentication_section.js"></script>
    <script src="js/chat_section.js"></script>
    <script src="js/lobby_section.js"></script>
    <script src="js/theme_utilities.js"></script>
  </head>
  <body>
    <!-- Top Bar -->
    <div id="top-bar" style="display:none; align-items:center; justify-content:space-between; padding:8px 0;">
        <span id="theme-toggle" style="cursor:pointer; font-size:1.3em; margin-right:16px;">🌙</span>
        <span id="alias-display" style="cursor:pointer; font-weight:bold; flex:1; text-align:center;">anon</span>
        <span id="room-display" style="margin-right:16px;"></span>
        <span id="lobby-button" style="cursor:pointer; margin-right:16px; display:none;" onclick="backToLobby()">⬅ Lobby</span>
    </div>

    <!-- Authentication UI -->
    <div id="auth-container">
        <input id="username" type="text" maxlength="30" placeholder="Username">
        <input id="password" type="password" placeholder="Password">
        <div style="margin: 8px 0;">
            <input type="checkbox" id="anonymousCheckbox" onchange="toggleAnonymous()">
            <label for="anonymousCheckbox">Join as anonymous</label>
        </div>
        <div style="display:flex; width:100%; justify-content:center;">
            <button onclick="login()">Login</button>
            <button onclick="register()">Register</button>
        </div>
        <div id="authStatus"></div>
    </div>
    <!-- Lobby UI: shown after logging in. Lists General and the public rooms with people in them -->
    <div id="lobby-container" style="display:none;">
        <h5>Rooms</h5>
        <ul id="room-list"></ul>

        <h6>Create or rejoin a room</h6>
        <input id="createRoomName" type="text" maxlength="40" placeholder="Room name">
        <div class="lobby-options">
            <input type="radio" name="createRoomType" id="createPublic" checked onchange="toggleCreateRoomType()">
            <label for="createPublic">Public (listed)</label>
            <input type="radio" name="createRoomType" id="createPrivate" onchange="toggleCreateRoomType()">
            <label for="createPrivate">Private (password)</label>
        </div>
        <input id="createRoomPassword" type="password" placeholder="Room password" style="display:none;">
        <div class="lobby-options">
            <input type="checkbox" id="createRoomHistory" checked>
            <label for="createRoomHistory">Keep history</label>
        </div>
        <button onclick="createRoom()">Create / join</button>

        <!-- A private room is shared only by people with the same name, password AND history setting -->
        <h6>Join a private room</h6>
        <input id="joinRoomName" type="text" maxlength="40" placeholder="Room name">
        <input id="joinRoomPassword" type="password" placeholder="Room password">
        <div class="lobby-options">
            <input type="checkbox" id="joinRoomHistory" checked>
            <label for="joinRoomHistory">Room keeps history (must match how it was created)</label>
        </div>
        <button onclick="joinPrivateRoom()">Join</button>

        <!-- Only shown to moderators -->
        <div id="moderation-panel" style="display:none;">
            <h6>Banned</h6>
            <ul id="ban-list"></ul>
        </div>
        <div id="lobbyStatus"></div>
    </div>
    <!-- Chat UI -->
    <div id="chat-container" style="display:none;">
        <div id="notifications"></div>
        <div id="messages"></div>
    </div>
    <div id="input-area" style="display:none;">
        <textarea id="msgInput" placeholder="Type your message..." maxlength="5000" class="input" autocomplete="off" autofocus="on" rows="1" style="resize: none; width: 70%;"></textarea>
        <div class="emotion">
            <span class="emotion-Icon">
                <i class="fa fa-smile-o fa-lg fa-fw" aria-hidden="true"></i>
                <div class="emotion-area"></div>
            </span>
            <span class="people">
                <i class="fa fa-user-o fa-lg fa-fw" aria-hidden="true"></i>
                <div class="people-online"></div>
            </span>
        </div>
        <button onclick="sendMsg()">Send</button>
    </div>
    <!--<form action="/" method="POST" id="chatForm" style="display:none;">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xs-12 col-sm-10 col-md-10 col-lg-10 col-xl-10">
                    <div class="emotion">
                        <div id="txt" class="input" autocomplete="off" autofocus="on" oninput="isTyping()"  contenteditable="true" placeholder="Enter your message here..."></div>
                            <span class="emotion-Icon">
                            <i class="fa fa-smile-o fa-lg fa-fw" aria-hidden="true"></i>
                            <div class="emotion-area"></div>
                            </span>
                            <span class="people">
                                <i class="fa fa-user-o fa-lg fa-fw" aria-hidden="true"></i>
